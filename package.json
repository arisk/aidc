{
  "name": "aidc",
  "version": "0.10.0",
  "description": "Zero-dependency encoder and decoder for GS1 element strings, Digital Link, EPC and barcodes (EAN/UPC, ITF-14, GS1-128, DataMatrix, QR).",
  "keywords": [
    "application-identifier",
    "barcode",
    "datamatrix",
    "digital-link",
    "epc",
    "gs1",
    "gtin",
    "qr"
  ],
  "homepage": "https://github.com/arisk/aidc#readme",
  "bugs": "https://github.com/arisk/aidc/issues",
  "license": "MIT",
  "author": "Ari Karageorgos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arisk/aidc.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./digital-link": {
      "types": "./dist/digital-link.d.ts",
      "default": "./dist/digital-link.js"
    },
    "./ean-upc": {
      "types": "./dist/ean-upc.d.ts",
      "default": "./dist/ean-upc.js"
    },
    "./itf": {
      "types": "./dist/itf.d.ts",
      "default": "./dist/itf.js"
    },
    "./gs1-128": {
      "types": "./dist/gs1-128.d.ts",
      "default": "./dist/gs1-128.js"
    },
    "./datamatrix": {
      "types": "./dist/datamatrix.d.ts",
      "default": "./dist/datamatrix.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "default": "./dist/qr.js"
    },
    "./epc": {
      "types": "./dist/epc.d.ts",
      "default": "./dist/epc.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "test:oracle": "vitest run --project oracle --project oracle-browser",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --project unit --coverage",
    "bench": "pnpm build && vitest bench --run --project \"bench (bench)\" --reporter=verbose",
    "gen": "node scripts/gen-ai-table.ts && node scripts/gen-epc-tables.ts",
    "ncu": "pnpm dlx npm-check-updates -u --cooldown 3 && pnpm install",
    "check:package": "publint && attw --pack --profile esm-only",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm coverage && pnpm test:oracle && pnpm check:package",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "bwip-js": "4.11.4",
    "epc-tds": "1.4.1",
    "fast-check": "4.10.2",
    "gs1encoder": "1.4.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zxing-wasm": "3.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1"
}
